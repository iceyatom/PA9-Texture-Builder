{
  "schemaVersion": 1,
  "id": "texturebuilder",
  "version": "${version}",
  "name": "PA9 Texture Builder",
  "description": "Weighted-random hotbar texturing for manual building. Silently switches the active hotbar slot to a weighted random pick from a configurable pool immediately before each block placement, then restores it.",
  "authors": [
    "PersonalAtom9"
  ],
  "contact": {
    "homepage": "https://www.youtube.com/@PersonalAtom9",
    "sources": ""
  },
  "license": "MIT",
  "icon": "assets/texturebuilder/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.yourname.texturebuilder.TextureBuilderClient"
    ],
    "modmenu": [
      "com.yourname.texturebuilder.compat.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "texturebuilder.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.6",
    "fabric": ">=0.58.0",
    "minecraft": ">=1.19 <1.19.3-",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*"
  }
}
